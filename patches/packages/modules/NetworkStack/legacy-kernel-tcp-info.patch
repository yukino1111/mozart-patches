diff --git a/src/com/android/networkstack/netlink/TcpSocketTracker.java b/src/com/android/networkstack/netlink/TcpSocketTracker.java
index ef33f13a119fe8068ebc5de3af416619deec1251..1f9469739cd3530812f8cac2382e32676cfb8b23 100644
--- a/src/com/android/networkstack/netlink/TcpSocketTracker.java
+++ b/src/com/android/networkstack/netlink/TcpSocketTracker.java
@@ -578,7 +578,20 @@ public class TcpSocketTracker {
         public boolean isTcpInfoParsingSupported() {
             // Request tcp info from NetworkStack directly needs extra SELinux permission added
             // after Q release.
-            return ShimUtils.isReleaseOrDevelopmentApiAbove(Build.VERSION_CODES.Q);
+            if (!ShimUtils.isReleaseOrDevelopmentApiAbove(Build.VERSION_CODES.Q)) return false;
+
+            // TcpSocketTracker needs tcpi_segs_out and tcpi_segs_in, which were added to
+            // struct tcp_info in Linux 4.2. Older kernels return a shorter structure that cannot
+            // provide the packet counters used by data-stall detection.
+            final String[] version = Os.uname().release.split("\\.", 3);
+            if (version.length < 2) return false;
+            try {
+                final int major = Integer.parseInt(version[0]);
+                final int minor = Integer.parseInt(version[1]);
+                return major > 4 || (major == 4 && minor >= 2);
+            } catch (NumberFormatException e) {
+                return false;
+            }
         }
 
