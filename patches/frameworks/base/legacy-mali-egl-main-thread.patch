 #define LOG_TAG "GraphicsEnvironment"
 
+#include <EGL/egl.h>
+#include <android-base/properties.h>
 #include <graphicsenv/GraphicsEnv.h>
+#include <log/log.h>
 #include <nativehelper/ScopedUtfChars.h>
 #include <nativeloader/native_loader.h>
+
+#include <mutex>
+#include <thread>
+#include <unistd.h>
+
 #include "core_jni_helpers.h"
 
 namespace {
 
+extern "C" EGLAPI const char* eglQueryStringImplementationANDROID(EGLDisplay display, EGLint name);
+
+struct LegacyEglWarmupResult {
+    EGLDisplay display = EGL_NO_DISPLAY;
+    EGLint getDisplayError = EGL_SUCCESS;
+    EGLBoolean initialized = EGL_FALSE;
+    EGLint major = 0;
+    EGLint minor = 0;
+    EGLint initializeError = EGL_SUCCESS;
+    bool publicExtensions = false;
+    EGLint publicExtensionsError = EGL_SUCCESS;
+    bool privateExtensions = false;
+    EGLint privateExtensionsError = EGL_SUCCESS;
+    EGLBoolean chosen = EGL_FALSE;
+    EGLint count = 0;
+    EGLint chooseError = EGL_SUCCESS;
+    bool usable = false;
+};
+
+LegacyEglWarmupResult initializeLegacyEgl(bool retain) {
+    LegacyEglWarmupResult result;
+    result.display = eglGetDisplay(EGL_DEFAULT_DISPLAY);
+    result.getDisplayError = eglGetError();
+    if (result.display == EGL_NO_DISPLAY) {
+        return result;
+    }
+
+    result.initialized = eglInitialize(result.display, &result.major, &result.minor);
+    result.initializeError = eglGetError();
+    result.publicExtensions = eglQueryString(result.display, EGL_EXTENSIONS) != nullptr;
+    result.publicExtensionsError = eglGetError();
+    result.privateExtensions =
+            eglQueryStringImplementationANDROID(result.display, EGL_EXTENSIONS) != nullptr;
+    result.privateExtensionsError = eglGetError();
+
+    EGLint attribs[] = {
+            EGL_RENDERABLE_TYPE, EGL_OPENGL_ES2_BIT,
+            EGL_RED_SIZE, 8,
+            EGL_GREEN_SIZE, 8,
+            EGL_BLUE_SIZE, 8,
+            EGL_ALPHA_SIZE, 8,
+            EGL_DEPTH_SIZE, 0,
+            EGL_CONFIG_CAVEAT, EGL_NONE,
+            EGL_STENCIL_SIZE, 8,
+            EGL_SURFACE_TYPE, EGL_WINDOW_BIT,
+            EGL_NONE,
+    };
+    EGLConfig config = nullptr;
+    result.count = 1;
+    result.chosen =
+            eglChooseConfig(result.display, attribs, &config, 1, &result.count);
+    result.chooseError = eglGetError();
+    result.usable = result.initialized != EGL_FALSE && result.major >= 1 &&
+            result.privateExtensions && result.chosen != EGL_FALSE && result.count == 1;
+
+    if (!retain || !result.usable) {
+        eglTerminate(result.display);
+    }
+    return result;
+}
+
+void logLegacyEglWarmup(const char* stage, const LegacyEglWarmupResult& result) {
+    ALOGI("Mozart legacy EGL main-thread warmup pid=%d tid=%d stage=%s "
+          "display=%p/%#x initialized=%u version=%d.%d/%#x public=%d/%#x "
+          "private=%d/%#x chosen=%u count=%d/%#x usable=%d",
+          getpid(), gettid(), stage, result.display, result.getDisplayError,
+          result.initialized, result.major, result.minor, result.initializeError,
+          result.publicExtensions, result.publicExtensionsError, result.privateExtensions,
+          result.privateExtensionsError, result.chosen, result.count, result.chooseError,
+          result.usable);
+}
+
+void warmupLegacyEglOnMainThread() {
+    static std::mutex mutex;
+    static pid_t warmedPid = -1;
+
+    if (!android::base::GetBoolProperty("ro.hwui.legacy_egl_main_thread_warmup", false)) {
+        return;
+    }
+
+    const pid_t pid = getpid();
+    if (gettid() != pid) {
+        ALOGW("Skipping Mozart legacy EGL warmup outside process main thread: pid=%d tid=%d",
+              pid, gettid());
+        return;
+    }
+
+    std::lock_guard<std::mutex> lock(mutex);
+    if (warmedPid == pid) {
+        return;
+    }
+
+    LegacyEglWarmupResult workerResult;
+    std::thread worker([&workerResult]() {
+        workerResult = initializeLegacyEgl(false);
+    });
+    worker.join();
+    logLegacyEglWarmup("sacrificial-worker", workerResult);
+
+    const LegacyEglWarmupResult mainResult = initializeLegacyEgl(true);
+    logLegacyEglWarmup("retained-main", mainResult);
+    warmedPid = pid;
+}
+
 bool isDebuggable_native() {
     return android::GraphicsEnv::getInstance().isDebuggable();
 }
