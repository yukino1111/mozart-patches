diff --git a/hardware.c b/hardware.c
index 6e72ce9f344544a1d3f05792abd499711f8681d6..e2b7743746da1012b94ec55c70b46162d4a56af4 100644
--- a/hardware.c
+++ b/hardware.c
@@ -167,6 +167,30 @@ static bool path_in_path(const char *path, const char *in_path) {
         real_path[real_in_path_len] == '/';
 }
 
+static bool is_legacy_mozart_gralloc(const char *name, const char *subname) {
+    return strcmp(name, "gralloc") == 0 &&
+        strcmp(subname, "hi3635") == 0;
+}
+
+static bool module_path_accessible(const char *path, const char *in_path,
+                                   const char *name, const char *subname) {
+    if (path_in_path(path, in_path)) {
+        return access(path, R_OK) == 0;
+    }
+
+    /*
+     * Application mount namespaces on mozart cannot canonicalize the legacy
+     * /vendor -> /system/vendor path even though the exact HAL remains
+     * readable. Keep the traversal check for every other module and permit
+     * only the fixed legacy gralloc name assembled under a known HAL path.
+     */
+    if (is_legacy_mozart_gralloc(name, subname) && access(path, R_OK) == 0) {
+        ALOGW("Using legacy mozart gralloc path without realpath: %s", path);
+        return true;
+    }
+    return false;
+}
+
 /*
  * Check if a HAL with given name and subname exists, if so return 0, otherwise
  * otherwise return negative.  On success path will contain the path to the HAL.
@@ -176,18 +200,18 @@ static int hw_module_exists(char *path, size_t path_len, const char *name,
 {
     snprintf(path, path_len, "%s/%s.%s.so",
              HAL_LIBRARY_PATH3, name, subname);
-    if (path_in_path(path, HAL_LIBRARY_PATH3) && access(path, R_OK) == 0)
+    if (module_path_accessible(path, HAL_LIBRARY_PATH3, name, subname))
         return 0;
 
     snprintf(path, path_len, "%s/%s.%s.so",
              HAL_LIBRARY_PATH2, name, subname);
-    if (path_in_path(path, HAL_LIBRARY_PATH2) && access(path, R_OK) == 0)
+    if (module_path_accessible(path, HAL_LIBRARY_PATH2, name, subname))
         return 0;
 
 #ifndef __ANDROID_VNDK__
     snprintf(path, path_len, "%s/%s.%s.so",
              HAL_LIBRARY_PATH1, name, subname);
-    if (path_in_path(path, HAL_LIBRARY_PATH1) && access(path, R_OK) == 0)
+    if (module_path_accessible(path, HAL_LIBRARY_PATH1, name, subname))
         return 0;
 #endif
 
