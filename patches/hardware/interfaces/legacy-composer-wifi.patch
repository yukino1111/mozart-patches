@@ -16,9 +16,16 @@
 
 #define LOG_TAG "light"
 
+#include <android-base/properties.h>
 #include <log/log.h>
 
+#include <errno.h>
+#include <fcntl.h>
+#include <linux/fb.h>
 #include <stdio.h>
+#include <string.h>
+#include <sys/ioctl.h>
+#include <unistd.h>
 
 #include "Light.h"
 
@@ -28,6 +35,30 @@ namespace light {
 namespace V2_0 {
 namespace implementation {
 
+namespace {
+
+bool isMozart() {
+    static const bool value = android::base::GetProperty("ro.product.device", "") == "mozart";
+    return value;
+}
+
+bool unblankFramebuffer() {
+    const int fd = open("/dev/graphics/fb0", O_WRONLY);
+    if (fd < 0) {
+        ALOGE("Error opening LCD framebuffer: %s", strerror(errno));
+        return false;
+    }
+
+    const int ret = ioctl(fd, FBIOBLANK, FB_BLANK_UNBLANK);
+    if (ret < 0) {
+        ALOGE("Error unblanking LCD framebuffer: %s", strerror(errno));
+    }
+    close(fd);
+    return ret == 0;
+}
+
+}  // namespace
+
 static_assert(LIGHT_FLASH_NONE == static_cast<int>(Flash::NONE),
     "Flash::NONE must match legacy value.");
