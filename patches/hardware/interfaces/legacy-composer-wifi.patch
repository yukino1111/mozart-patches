@@ -64,7 +95,22 @@ Return<Status> Light::setLight(Type type, const LightState& state)  {
         .brightnessMode = static_cast<int>(state.brightnessMode),
     };
 
-    int ret = hwLight->set_light(hwLight, &legacyState);
+    int ret;
+    if (type == Type::BACKLIGHT && isMozart()) {
+        const bool backlightOn = (state.color & 0x00ffffff) != 0;
+        std::lock_guard<std::mutex> lock(mFramebufferMutex);
+        bool framebufferReady = true;
+        if (backlightOn && !mBacklightOn) {
+            // Unblank before enabling the backlight so the previous front buffer is not exposed.
+            framebufferReady = unblankFramebuffer();
+        }
+        ret = hwLight->set_light(hwLight, &legacyState);
+        if (ret == 0) {
+            mBacklightOn = backlightOn && framebufferReady;
+        }
+    } else {
+        ret = hwLight->set_light(hwLight, &legacyState);
+    }
 
     switch (ret) {
         case -ENOSYS:
             return Status::BRIGHTNESS_NOT_SUPPORTED;
