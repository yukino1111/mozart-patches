# Audio
ro.config.hw_dts=false

# Bluetooth
ro.bt.bdaddr_path=/data/misc/bluedroid/macbt

# CPU
ro.hardware.alter=Hisilicon Kirin 930

# Dalvik
dalvik.vm.heapstartsize=16m
dalvik.vm.heapgrowthlimit=192m
dalvik.vm.heapsize=512m
dalvik.vm.heaptargetutilization=0.75
dalvik.vm.heapminfree=2m
dalvik.vm.heapmaxfree=8m

# Display
ro.sf.lcd_density=320
ro.opengles.version=196608
ro.config.mmu_en=1
ro.hardware.egl=mali
ro.hardware.gralloc=hi3635
ro.hardware.copybit=hi3635
ro.hardware.memtrack=hi3635

# HWUI
ro.hwui.texture_cache_size=72
ro.hwui.layer_cache_size=48
ro.hwui.path_cache_size=32
ro.hwui.gradient_cache_size=1
ro.hwui.drop_shadow_cache_size=6
ro.hwui.r_buffer_cache_size=8
ro.hwui.texture_cache_flushrate=0.4
ro.hwui.text_small_cache_width=1024
ro.hwui.text_small_cache_height=1024
ro.hwui.text_large_cache_width=2048
ro.hwui.text_large_cache_height=1024
debug.hwui.use_partial_updates=false
debug.hwui.use_buffer_age=false
debug.hwui.renderer=opengl
ro.zygote.disable_gl_preload=true
debug.hwui.disable_egl_preload=true
ro.hwui.legacy_egl_main_thread_warmup=true
debug.hwui.disable_draw_reorder=true
debug.hwui.disable_draw_defer=true
debug.hwui.skip_empty_damage=false

# Media
media.stagefright.use-awesome=false
ro.config.hw_media_flags=3

# Performance
ro.am.reschedule_service=true
ro.config.enable_rcc=true

# SDcard
ro.sys.sdcardfs=true

# Sensors
ro.config.hw_sensorhub=true

# Surfaceflinger
debug.sf.disable_backpressure=1
debug.sf.latch_unsignaled=1

# USB
persist.sys.usb.config.extra=none
